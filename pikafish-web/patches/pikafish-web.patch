+    std::stringstream raw = read_compressed_nnue(compressed);
+    network.modify_and_replicate([this, &raw](NN::Network& network_) {
+        raw.clear();
+        raw.seekg(0);
+        network_.load_raw(raw, networkFile);
+    });
+    threads.clear();
+    threads.ensure_network_replicated();
+}
